# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
GUILD_ID=your_guild_id_here

# Category ID where modmail tickets will be created
MODMAIL_CATEGORY_ID=your_category_id_here

# Role ID that can access/reply to modmail tickets (Staff/Mod role)
STAFF_ROLE_ID=your_staff_role_id_here

# Channel ID for modmail logs (optional)
MODMAIL_LOG_CHANNEL_ID=

# OpenAI / xAI compatible API key for AI features
# You can use OpenAI, or xAI Grok API (https://console.x.ai)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Bot prefix for legacy commands (optional, slash commands preferred)
PREFIX=!
