# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
GUILD_ID=your_guild_id_here

# Category ID where modmail tickets will be created
MODMAIL_CATEGORY_ID=your_category_id_here

# Role ID that can access/reply to modmail tickets (Staff/Mod role)
STAFF_ROLE_ID=your_staff_role_id_here

# Channel ID for modmail logs (optional)
MODMAIL_LOG_CHANNEL_ID=

# ========== AI CONFIG ==========
# Recommended: Groq (super fast + free tier)
# Get your key at: https://console.groq.com/keys
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Alternative providers (just change the 3 values above):
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# xAI Grok:  AI_BASE_URL=https://api.x.ai/v1         AI_MODEL=grok-beta
